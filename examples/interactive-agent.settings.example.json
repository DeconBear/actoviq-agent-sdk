{
  "bypassPermissions": true,
  "env": {
    "HADAMARD_BASE_URL": "https://your-hadamard-compatible-endpoint.example.com",
    "HADAMARD_AUTH_TOKEN": "replace-with-your-token",
    "HADAMARD_DEFAULT_MIN_MODEL": "replace-with-your-small-model",
    "HADAMARD_DEFAULT_MEDIUM_MODEL": "replace-with-your-balanced-model",
    "HADAMARD_DEFAULT_MAX_MODEL": "replace-with-your-large-model"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Write",
      "Read",
      "WebSearch",
      "WebFetch",
      "Edit",
      "Glop",
      "Grep",
      "LSP",
      "PowerShell"
    ]
  }
}
