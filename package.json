{
  "name": "actoviq-agent-sdk",
  "version": "0.4.12",
  "description": "Agent team platform — multi-agent, multi-runtime, model team collaboration with TUI, GUI, and MCP.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeconBear/hadamard.git"
  },
  "homepage": "https://github.com/DeconBear/hadamard#readme",
  "bugs": {
    "url": "https://github.com/DeconBear/hadamard/issues"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "build": {
    "appId": "com.hadamard.desktop",
    "productName": "Hadamard",
    "copyright": "Copyright Hadamard",
    "artifactName": "Hadamard-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist_electron"
    },
    "extraMetadata": {
      "main": "dist/src/gui/electronMain.js"
    },
    "icon": "assets/hadamard-icon.png",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "vendor/**/*",
      "package.json",
      "node_modules/**/*",
      "!**/node_modules/bun/**",
      "!**/node_modules/@oven/**",
      "!**/node_modules/electron/**",
      "!**/node_modules/{typescript,vitepress,vitest,tsx,playwright,@types/**,@anthropic-ai/claude-agent-sdk}/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "assets/hadamard-icon.ico",
      "assets/hadamard-icon.png"
    ],
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "DeconBear",
      "repo": "hadamard",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hadamard"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "forceCodeSigning": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "maintainer": "Hadamard"
    }
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "hadamard-tui": "./bin/hadamard-tui.js",
    "hadamard-gui": "./bin/hadamard-gui.js",
    "hadamard-app-server": "./bin/hadamard-app-server.js",
    "hadamard-link-runtime": "./bin/hadamard-link-runtime.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./core": {
      "types": "./dist/src/core/index.d.ts",
      "default": "./dist/src/core/index.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime-v2/index.d.ts",
      "default": "./dist/src/runtime-v2/index.js"
    },
    "./providers": {
      "types": "./dist/src/providers-v2/index.d.ts",
      "default": "./dist/src/providers-v2/index.js"
    },
    "./providers/anthropic": {
      "types": "./dist/src/providers-v2/anthropic.d.ts",
      "default": "./dist/src/providers-v2/anthropic.js"
    },
    "./providers/openai-responses": {
      "types": "./dist/src/providers-v2/openai-responses.d.ts",
      "default": "./dist/src/providers-v2/openai-responses.js"
    },
    "./providers/openai-chat": {
      "types": "./dist/src/providers-v2/openai-chat.d.ts",
      "default": "./dist/src/providers-v2/openai-chat.js"
    },
    "./events": {
      "types": "./dist/src/events/index.d.ts",
      "default": "./dist/src/events/index.js"
    },
    "./surfaces": {
      "types": "./dist/src/surfaces/index.d.ts",
      "default": "./dist/src/surfaces/index.js"
    },
    "./orchestration": {
      "types": "./dist/src/orchestration/index.d.ts",
      "default": "./dist/src/orchestration/index.js"
    },
    "./workflow": {
      "types": "./dist/src/workflow-v2/index.d.ts",
      "default": "./dist/src/workflow-v2/index.js"
    },
    "./profiles": {
      "types": "./dist/src/profiles/index.d.ts",
      "default": "./dist/src/profiles/index.js"
    },
    "./node": {
      "types": "./dist/src/node/index.d.ts",
      "default": "./dist/src/node/index.js"
    },
    "./compat": {
      "types": "./dist/src/compat/index.d.ts",
      "default": "./dist/src/compat/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "README-zh.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "vendor/hadamard-runtime/cli.js"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "node scripts/generate-gui-icon.mjs && npm run clean && tsc -p tsconfig.build.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepack": "npm run build",
    "prepare:public-runtime": "node scripts/prepare-public-runtime.mjs",
    "prepare:xterm": "node scripts/prepare-xterm.mjs",
    "prepare:gui-launcher": "node scripts/prepare-gui-launcher.mjs",
    "make:ico": "python scripts/make-ico.py",
    "generate:icon": "node scripts/generate-gui-icon.mjs && npm run make:ico",
    "sync:hadamard-runtime": "node scripts/sync-hadamard-runtime-upstream.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist:win": "npm run prepare:xterm && npm run build && electron-builder --win --x64 && electron-builder --win --arm64",
    "dist:mac": "npm run prepare:xterm && npm run build && electron-builder --mac --x64 && electron-builder --mac --arm64",
    "dist:linux": "npm run prepare:xterm && npm run build && electron-builder --linux --x64",
    "dist:gui": "npm run prepare:xterm && npm run build && electron-builder --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gui:e2e": "npm run build && node scripts/verify-gui-runtime-model-chat.mjs",
    "test:gui:external-cli-e2e": "npm run build && node scripts/verify-gui-external-cli-runtime.mjs",
    "test:sdk-v2:coverage": "vitest run --config vitest.sdk-v2.config.ts && node scripts/verify-sdk-v2-coverage.mjs",
    "verify:package": "node scripts/verify-package-exports.mjs && node scripts/public-api.mjs",
    "verify:packed": "node scripts/verify-packed-package.mjs",
    "package:check": "npm run build && npm run verify:package && npm run verify:packed && npm pack --dry-run",
    "api:check": "node scripts/public-api.mjs",
    "api:update": "npm run build && node scripts/public-api.mjs --update",
    "extension:build": "npm --prefix extensions/vscode run build",
    "extension:test": "npm --prefix extensions/vscode test",
    "bench:standard": "tsx bench/standard/run-all.ts",
    "bench:runtime:smoke": "tsx bench/runtime/run.ts --mode smoke --output tmp/runtime-benchmark-smoke.json",
    "bench:runtime": "tsx bench/runtime/run.ts --mode full --output tmp/runtime-benchmark-full.json",
    "bench:runtime:compare": "tsx bench/runtime/compare.ts",
    "bench:memory": "tsx bench/memory/run.ts",
    "bench:goal": "tsx bench/goal/run.ts",
    "smoke": "npm run build && tsx scripts/integration-smoke.ts",
    "example:hadamard-quickstart": "npm run build && tsx examples/hadamard-quickstart.ts",
    "example:hadamard-session": "npm run build && tsx examples/hadamard-session.ts",
    "example:hadamard-stream-loop": "npm run build && tsx examples/hadamard-stream-loop.ts",
    "example:hadamard-file-tools": "npm run build && tsx examples/hadamard-file-tools.ts",
    "example:hadamard-agent-helpers": "npm run build && tsx examples/hadamard-agent-helpers.ts",
    "example:hadamard-platform": "npm run build && tsx examples/hadamard-platform.ts",
    "example:hadamard-parallel": "npm run build && tsx examples/hadamard-parallel.ts",
    "example:hadamard-session-manager": "npm run build && tsx examples/hadamard-session-manager.ts",
    "example:hadamard-checkpoint": "npm run build && tsx examples/hadamard-checkpoint.ts",
    "example:hadamard-workflow": "npm run build && tsx examples/hadamard-workflow.ts",
    "example:hadamard-workflow-annotated": "npm run build && tsx examples/hadamard-workflow-annotated.ts",
    "example:hadamard-workflow-agent-orchestration": "npm run build && tsx examples/hadamard-workflow-agent-orchestration.ts",
    "example:hadamard-scheduling": "npm run build && tsx examples/hadamard-scheduling.ts",
    "example:hadamard-react-loop": "npm run build && tsx examples/hadamard-react-loop.ts",
    "example:hadamard-computer-use": "npm run build && tsx examples/hadamard-computer-use.ts",
    "example:hadamard-browser-use": "npm run build && tsx examples/hadamard-browser-use.ts",
    "example:hadamard-memory": "npm run build && tsx examples/hadamard-memory.ts",
    "example:hadamard-dream": "npm run build && tsx examples/hadamard-dream.ts",
    "example:hadamard-skills": "npm run build && tsx examples/hadamard-skills.ts",
    "example:hadamard-swarm": "npm run build && tsx examples/hadamard-swarm.ts",
    "example:bridge-introspection": "npm run build && tsx examples/bridge-introspection.ts",
    "example:bridge-interactive-agent": "npm run build && tsx examples/bridge-interactive-agent.ts",
    "example:hadamard-workspaces": "npm run build && tsx examples/hadamard-workspaces.ts",
    "example:bridge-sessions": "npm run build && tsx examples/bridge-sessions.ts",
    "example:bridge-session-messages": "npm run build && tsx examples/bridge-session-messages.ts",
    "example:hadamard-buddy": "npm run build && tsx examples/hadamard-buddy.ts",
    "example:bridge-sdk": "npm run build && tsx examples/bridge-sdk.ts",
    "example:profiles": "tsx examples/profiles/all-profiles.ts"
  },
  "keywords": [
    "agent",
    "sdk",
    "hadamard",
    "mcp",
    "runtime"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "electron-updater": "^6.8.9",
    "glob": "^13.0.0",
    "lodash-es": "^4.17.23",
    "zod": "^4.1.12"
  },
  "optionalDependencies": {
    "@e2b/desktop": "^2.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "bun": "^1.3.11",
    "electron": "^42.4.1",
    "node-pty": "^1.1.0",
    "playwright": "^1.61.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.161",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "electron-builder": "^26.0.0",
    "rcedit": "^4.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.3",
    "vitest": "^4.0.8"
  }
}
