{
  "name": "hadamard",
  "displayName": "Hadamard",
  "description": "Thin VS Code/Cursor client for the Hadamard app-server.",
  "version": "0.1.0",
  "publisher": "hadamard",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onView:hadamard.sessions",
    "onCommand:hadamard.openSession",
    "onChatParticipant:hadamard.chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "hadamard.openSession", "title": "Hadamard: Open Session" },
      { "command": "hadamard.selectSession", "title": "Hadamard: Select Session" },
      { "command": "hadamard.newSession", "title": "Hadamard: New Session" },
      { "command": "hadamard.refreshSessions", "title": "Hadamard: Refresh Sessions" },
      { "command": "hadamard.reviewDiff", "title": "Hadamard: Review Session Diff" },
      { "command": "hadamard.applyDiff", "title": "Hadamard: Apply Session Diff" },
      { "command": "hadamard.restoreCheckpoint", "title": "Hadamard: Restore Checkpoint" },
      { "command": "hadamard.setGoal", "title": "Hadamard: Set Goal" },
      { "command": "hadamard.rememberApproval", "title": "Hadamard: Remember Approval" }
    ],
    "chatParticipants": [
      {
        "id": "hadamard.chat",
        "name": "hadamard",
        "fullName": "Hadamard",
        "description": "Work with the current Hadamard Session."
      }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "hadamard", "title": "Hadamard", "icon": "media/hadamard.svg" }
      ]
    },
    "views": {
      "hadamard": [
        { "id": "hadamard.sessions", "name": "Sessions" },
        { "id": "hadamard.approvals", "name": "Approvals" }
      ]
    },
    "configuration": {
      "title": "Hadamard",
      "properties": {
        "hadamard.appServer.command": {
          "type": "string",
          "default": "hadamard-app-server",
          "description": "App-server executable."
        },
        "hadamard.appServer.args": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional app-server arguments."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  }
}
